// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  shipmentDepartures ShipmentDeparture[]
  shipmentArrivals ShipmentArrival[]
  accountChanges AccountChange[]
  accountCreations AccountCreation[]
  containerCorrections ContainerCorrection[]
  containerPreparations ContainerPreparation[]
  containerRemovals ContainerRemoval[]
  shipmentRemovals ShipmentRemoval[]
  receiptRejections ReceiptRejection[]
  returnActions ReturnAction[]
  definitionChanges DefinitionChange[]
  stockVerifications StockVerification[]
  legacyReceiptLinks LegacyReceiptLink[]
  stockCorrections StockCorrection[]
  monitoringRules MonitoringRule[]
  hallAlerts HallAlert[]
  hallAlertEntries HallAlertEntry[]
  receiptAllocations ReceiptAllocation[]
  transferSources TransferSource[]
  shippingCorrections ShippingCorrection[]
  transferActions TransferAction[]
  textTranslations TextTranslation[]
  id Int @id @default(autoincrement())
  name String
  createdAt DateTime @default(now())
  userProfileRecords UserProfile[]
  shippingInformationRecords ShippingInformation[]
  containerProfileRecords ContainerProfile[]
  locationOriginRecords LocationOrigin[]
  wasteProfileRecords WasteProfile[]
  containerTypeRecords ContainerType[]
  preStorageLocationRecords PreStorageLocation[]
  preStorageEntryRecords PreStorageEntry[]
  preStorageResponsibleEmployeeRecords PreStorageResponsibleEmployee[]
  preStorageConditionsRecords PreStorageConditions[]
  finalStorageLocationRecords FinalStorageLocation[]
  storageTransferRequestRecords StorageTransferRequest[]
  finalStorageResponsibleEmployeeRecords FinalStorageResponsibleEmployee[]
  finalStorageConditionRecords FinalStorageCondition[]
}

enum UserRole {
  ADMINISTRATOR
  SUPERVISION
  EMPLOYEE
}

enum WorkArea {
  SHIPPING
  PRE_STORAGE
  FINAL_STORAGE
}

model UserProfile {
  workArea WorkArea?
  role UserRole @default(EMPLOYEE)
  username String? @unique
  displayName String?
  sessionVersion Int @default(0)
  organizationId Int?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  id                   Int                   @id @default(autoincrement())
  email                String                @unique
  password             String
  createdAt            DateTime              @default(now())
  companyId            Int
  companyName          String
  address              String
  active               Boolean               @default(true)
  administrator        Boolean
  shippingInformations ShippingInformation[]
}

// Setep 1 Shipping Informations

model ShippingInformation {
  organizationId Int?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  id                 Int                @id @default(autoincrement())
  entryDateTime      DateTime           @default(now())
  exitDateTime       DateTime?
  truckStatus        String             @default("IN")
  status             String             @default("pending")
  //Statuts: "pending", "accepted", "rejected".
  companyName        String
  driverName         String
  registrationPlates String
  containerProfiles  ContainerProfile[]
  userProfileId      Int?               @unique
  userProfile        UserProfile?       @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
}

model ContainerProfile {
  organizationId Int?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  id                    Int                  @id @default(autoincrement())
  createdAt             DateTime             @default(now())
  // Statuts: "pending", "accepted", "rejected"
  containerStatus       String               @default("pending")
  quantity              Int
  shippingInformationId Int //  foreign key
  shippingInformation   ShippingInformation? @relation(fields: [shippingInformationId], references: [id], onDelete: Cascade)
  locationOriginId      Int
  locationOrigin        LocationOrigin       @relation(fields: [locationOriginId], references: [id], onDelete: Restrict)
  wasteProfileId        Int
  wasteProfile          WasteProfile         @relation(fields: [wasteProfileId], references: [id], onDelete: Restrict)
}

model LocationOrigin {
  organizationId Int?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  id                Int                @id @default(autoincrement())
  name              String
  address           String
  origin            String
  archivedAt        DateTime?
  containerProfiles ContainerProfile[]

  // If we have a "containerProfiles" field in the "LocationOrigin" model that is of type "ContainerProfile[]", 
  // it means that it is expected that one location can be associated with multiple "ContainerProfile" entities.
}

model WasteProfile {
  organizationId Int?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  id                   Int                @id @default(autoincrement())
  name                 String
  typeOfWaste          String
  wasteDescription     String
  risksAndHazards      String
  processingMethods    String
  physicalProperties   String
  chemicalProperties   String
  biologicalProperties String
  collectionProcedures String
  archivedAt           DateTime?
  containerProfiles    ContainerProfile[]
  containerTypeId      Int                @unique
  containerType        ContainerType      @relation(fields: [containerTypeId], references: [id], onDelete: Restrict)
}

model ContainerType {
  organizationId Int?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  id                 Int           @id @default(autoincrement())
  name               String
  material           String
  volume             Float
  carryingCapacity   Float
  radioactivityLevel String
  physicalProperties String
  footprint          Float
  description        String
  archivedAt         DateTime?
  wasteProfile       WasteProfile?
}

// Step 2 "Pre-storage of waste"

model PreStorageLocation {
  organizationId Int?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  id                   Int                    @id @default(autoincrement())
  name                 String
  surfaceArea          Int
  containerFootprint   Int
  preStorageFor        String
  containerType        String
  wasteProfile         String
  preStorageEntry      PreStorageEntry[]
  preStorageConditions PreStorageConditions[]
}

model PreStorageEntry {
  receiptKey String? @unique
  receiptFingerprint String?
  organizationId Int?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  id                              Int                            @id @default(autoincrement())
  createdAt                       DateTime                       @default(now())
  quantity                        Int
  preStorageLocationId            Int
  preStorageLocation              PreStorageLocation             @relation(fields: [preStorageLocationId], references: [id], onDelete: Restrict)
  responsiblePreStorageEmployeeId Int?
  responsiblePreStorageEmployee   PreStorageResponsibleEmployee? @relation(fields: [responsiblePreStorageEmployeeId], references: [id], onDelete: Restrict)
}

model PreStorageResponsibleEmployee {
  organizationId Int?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  id                   Int                      @id @default(autoincrement())
  name                 String
  surname              String
  dateOfBirth          DateTime
  address              String
  qualifications       String
  safetyTraining       Boolean                  @default(false)
  // Set when the person may no longer be chosen for new records; history stays linked.
  archivedAt           DateTime?
  preStorageEntry      PreStorageEntry[]
  PreStorageConditions PreStorageConditions[]
  approvedTransfers    StorageTransferRequest[]
}

// Step 2.1 Pre-Storage Conditions

model PreStorageConditions {
  submissionKey String? @unique
  // How the values reached the form when read from a device: method, device and
  // the parameters the person confirmed against it. Null for manual entry.
  readingSource Json?
  recordedById Int?
  organizationId Int?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  id                              Int                           @id @default(autoincrement())
  createdAt                       DateTime                      @default(now())
  preStorageTemperature           Float
  preStorageRadiationLevel        Float
  preStorageHumidity              Float
  preStoragePressure              Int
  preStorageLocationId            Int
  preStorageResponsibleEmployeeId Int
  preStorageLocation              PreStorageLocation            @relation(fields: [preStorageLocationId], references: [id], onDelete: Restrict)
  preStorageResponsibleEmployee   PreStorageResponsibleEmployee @relation(fields: [preStorageResponsibleEmployeeId], references: [id], onDelete: Restrict)
}

// Step 3 "Final Storage of waste"

model FinalStorageLocation {
  organizationId Int?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  id                      Int                      @id @default(autoincrement())
  name                    String
  containerType           String
  containerFootprint      Int
  surfaceArea             Int
  depth                   Int
  quantity                Int                      @default(0)
  storageTransferRequests StorageTransferRequest[]
  finalStorageConditions  FinalStorageCondition[]
}

model StorageTransferRequest {
  version Int @default(0)
  actions TransferAction[]
  organizationId Int?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  id                 Int      @id @default(autoincrement())
  createdAt          DateTime @default(now())
  finalStorageStatus String   @default("requestPending") // "requestPending", "transportPending","requestRejeted", "accepted", "rejected"
  preStorageStatus   String   @default("pending") // "pending", "accepted", "rejected", "completed"
  requestedQuantity  Int

  // Location references
  requestedByRoom       String
  requestedByEmployeeId Int
  approvedByEmployeeId  Int?
  acceptedByEmployeeId  Int?

  requestedByEmployee FinalStorageResponsibleEmployee  @relation("RequestedBy", fields: [requestedByEmployeeId], references: [id], onDelete: Restrict)
  approvedByEmployee  PreStorageResponsibleEmployee?   @relation(fields: [approvedByEmployeeId], references: [id], onDelete: Restrict)
  acceptedByEmployee  FinalStorageResponsibleEmployee? @relation("AcceptedBy", fields: [acceptedByEmployeeId], references: [id], onDelete: Restrict)

  finalStorageLocationId Int?
  finalStorageLocation   FinalStorageLocation? @relation(fields: [finalStorageLocationId], references: [id], onDelete: Restrict)
}

model FinalStorageResponsibleEmployee {
  organizationId Int?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  id                     Int                      @id @default(autoincrement())
  name                   String
  surname                String
  dateOfBirth            DateTime
  qualifications         String
  address                String
  safetyTraining         Boolean
  // Set when the person may no longer be chosen for new records; history stays linked.
  archivedAt             DateTime?
  requestedTransfers     StorageTransferRequest[] @relation("RequestedBy")
  acceptedTransfers      StorageTransferRequest[] @relation("AcceptedBy")
  finalStorageConditions FinalStorageCondition[]
}

// Step 3.1 Storage Conditions

model FinalStorageCondition {
  submissionKey String? @unique
  readingSource Json?
  recordedById Int?
  organizationId Int?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  id                                Int                              @id @default(autoincrement())
  createdAt                         DateTime                         @default(now())
  finalStorageTemperature           Float
  finalStorageRadiationLevel        Float
  finalStorageHumidity              Float
  finalStoragePressure              Float
  finalStorageLocationId            Int
  finalStorageLocation              FinalStorageLocation             @relation(fields: [finalStorageLocationId], references: [id], onDelete: Restrict)
  finalStorageResponsibleEmployeeId Int?
  finalStorageResponsibleEmployee   FinalStorageResponsibleEmployee? @relation(fields: [finalStorageResponsibleEmployeeId], references: [id], onDelete: Restrict)
}

model AuthRateLimit {
  key String @id
  attempts Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

model TransferAction {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transferId Int
  transfer StorageTransferRequest @relation(fields: [transferId], references: [id], onDelete: Restrict)
  actionKey String @unique
  fingerprint String
  action String
  quantity Int
  actorId Int
  reason String?
  createdAt DateTime @default(now())
  @@index([organizationId, transferId])
}

model ShippingCorrection {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shipmentId Int
  actorId Int
  reason String
  before Json
  after Json
  actionKey String @unique
  fingerprint String
  createdAt DateTime @default(now())
  @@index([organizationId, shipmentId])
}

model ShipmentDeparture {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Restrict)
  shipmentId Int
  actorId Int
  actionKey String @unique
  fingerprint String
  snapshot Json
  createdAt DateTime @default(now())
  @@index([organizationId,shipmentId])
}

model ShipmentArrival {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shipmentId Int
  actorId Int
  actionKey String @unique
  fingerprint String
  snapshot Json
  createdAt DateTime @default(now())
  @@index([organizationId, shipmentId])
}

model AccountChange {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  targetUserId Int
  actorId Int
  actionKey String @unique
  fingerprint String
  reason String
  before Json
  after Json
  changedFields Json
  createdAt DateTime @default(now())
  @@index([organizationId, targetUserId])
}

model ReceiptAllocation {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receiptId Int
  shipmentId Int
  containerProfileId Int
  locationId Int
  quantity Int
  actorId Int
  // Null only when a legacy receipt linked later did not record a responsible person.
  responsibleEmployeeId Int?
  // Set when an administrator linked an earlier receipt afterwards; createdAt is then the link time.
  legacyLinkId Int?
  createdAt DateTime @default(now())
  @@index([organizationId, shipmentId])
  @@unique([receiptId, containerProfileId])
}

model TransferSource {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transferId Int
  receiptAllocationId Int
  shipmentId Int
  containerProfileId Int
  locationId Int
  destinationId Int
  quantity Int
  state String @default("reserved")
  approvalActionId Int
  resolutionActionId Int?
  @@unique([approvalActionId, receiptAllocationId])
  @@index([resolutionActionId])
  @@index([organizationId, receiptAllocationId])
  @@index([organizationId, shipmentId])
}

// Immutable creation receipt; credentials and personal fields are not stored here.
model AccountCreation {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  targetUserId Int
  actorId Int
  actionKey String @unique
  fingerprint String
  role UserRole
  workArea WorkArea?
  createdAt DateTime @default(now())
  @@index([organizationId, targetUserId])
}

model ContainerCorrection {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shipmentId Int
  containerProfileId Int
  actorId Int
  actionKey String @unique
  fingerprint String
  reason String
  before Json
  after Json
  createdAt DateTime @default(now())
  @@index([organizationId, shipmentId])
}

model ContainerPreparation {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shipmentId Int
  containerProfileId Int @unique
  actorId Int
  actionKey String @unique
  fingerprint String
  snapshot Json
  reason String?
  createdAt DateTime @default(now())
  @@index([organizationId, shipmentId])
}


model ContainerRemoval {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shipmentId Int
  containerProfileId Int @unique
  actorId Int
  actionKey String @unique
  fingerprint String
  reason String
  before Json
  createdAt DateTime @default(now())
  @@index([organizationId, shipmentId])
}

model ShipmentRemoval {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shipmentId Int @unique
  actorId Int
  actionKey String @unique
  fingerprint String
  reason String
  before Json
  createdAt DateTime @default(now())
  @@index([organizationId, id])
}

// Pre-storage inspection that returned incoming Container Profiles to Step 1. The
// profiles carry the expected and, for a quantity mismatch, the counted quantity.
// Rows are never edited; a Step 1 correction or removal follows as its own record.
model ReceiptRejection {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shipmentId Int
  locationId Int
  responsibleEmployeeId Int
  profiles Json
  reasons Json
  note String?
  actorId Int
  actionKey String @unique
  fingerprint String
  createdAt DateTime @default(now())
  @@index([organizationId, shipmentId])
}

// What Step 1 or Supervision did with a Pre-storage return: ESCALATED hands it to
// Supervision (the truck waits), RESENT sends the corrected profiles back to Step 2.
// changes holds the quantity before and after per profile; rows are never edited.
model ReturnAction {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shipmentId Int
  rejectionId Int
  action String
  note String
  changes Json
  actorId Int
  actorRole UserRole
  actionKey String @unique
  fingerprint String
  createdAt DateTime @default(now())
  @@index([organizationId, shipmentId])
}

enum DefinitionKind {
  LOCATION_ORIGIN
  WASTE_PROFILE
  CONTAINER_TYPE
  PRE_STORAGE_LOCATION
  FINAL_STORAGE_LOCATION
  PRE_STORAGE_EMPLOYEE
  FINAL_STORAGE_EMPLOYEE
}

enum DefinitionAction {
  CREATE
  UPDATE
  ARCHIVE
  RESTORE
  DELETE
}

// Administrative change of a Container Profile definition or storage configuration
// (halls and responsible persons). Snapshots keep the values that applied before
// and after the change, without personal details; rows are never edited.
model DefinitionChange {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  definitionType DefinitionKind
  definitionId Int
  action DefinitionAction
  actorId Int
  actionKey String @unique
  fingerprint String
  reason String?
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([organizationId, definitionType, definitionId])
  @@index([organizationId, createdAt])
}

enum StorageArea {
  PRE_STORAGE
  FINAL_STORAGE
}

// Result of a physical count or documentary check of one hall. It is evidence
// next to the recorded stock and never changes that stock; rows are never edited.
model StockVerification {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  area StorageArea
  locationId Int
  countedQuantity Int
  recordedQuantity Int
  recorded Json
  actorId Int
  actionKey String @unique
  fingerprint String
  reason String
  createdAt DateTime @default(now())
  @@index([organizationId, area, locationId])
}

// Administrator's documented link between a receipt recorded before receipt links
// existed and the accepted Container Profiles it contained. No movement is recorded.
model LegacyReceiptLink {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receiptId Int @unique
  locationId Int
  receiptQuantity Int
  receiptCreatedAt DateTime
  profiles Json
  actorId Int
  actionKey String @unique
  fingerprint String
  reason String
  createdAt DateTime @default(now())
  @@index([organizationId, locationId])
}

// Administrator-approved adjustment of recorded stock to a recorded verification.
model StockCorrection {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  area StorageArea
  locationId Int
  verificationId Int @unique
  countedQuantity Int
  delta Int
  before Json
  actorId Int
  actionKey String @unique
  fingerprint String
  reason String
  // Administrator's report: what was found, why it happened, actions and references.
  report Json?
  createdAt DateTime @default(now())
  @@index([organizationId, area, locationId])
}

enum MonitoringParameter {
  TEMPERATURE
  RADIATION
  HUMIDITY
  PRESSURE
}

enum AlertSeverity {
  WARNING
  CRITICAL
}

enum HallAlertEntryType {
  OPENED
  MEASURED
  OVERDUE
  READ
  MESSAGE
  RESOLVED
}

// Append-only versions of the range and expected interval for one parameter of a
// hall. The newest version applies; alerts keep a snapshot of the version they used.
model MonitoringRule {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  area StorageArea
  locationId Int
  parameter MonitoringParameter
  lowerDanger Float?
  lowerWarning Float?
  upperWarning Float?
  upperDanger Float?
  intervalHours Int
  approvalReference String
  reason String
  actorId Int
  actionKey String @unique
  fingerprint String
  createdAt DateTime @default(now())
  @@index([organizationId, area, locationId, parameter, createdAt])
}

// One alert per hall or room at a time: what is wrong there now. `problems` holds
// the parameters outside range and an overdue measurement ([] once a new
// measurement is within range). Supervision or an administrator marks it read,
// writes with the workers in its entries and resolves it. A partial unique index
// in the migration keeps one unresolved alert per hall or room.
model HallAlert {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  area StorageArea
  locationId Int
  severity AlertSeverity
  problems Json
  openedAt DateTime @default(now())
  changedAt DateTime @default(now())
  readAt DateTime?
  readById Int?
  resolvedAt DateTime?
  resolvedById Int?
  resolveNote String?
  entries HallAlertEntry[]
  @@index([organizationId, area, resolvedAt])
}

// History of an alert: measurements, reading, messages and the resolution.
// Rows are never changed.
model HallAlertEntry {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  alertId Int
  alert HallAlert @relation(fields: [alertId], references: [id], onDelete: Restrict)
  type HallAlertEntryType
  authorId Int?
  text String?
  problems Json?
  measurementId Int?
  createdAt DateTime @default(now())
  @@index([organizationId, alertId])
}

// AI translations of what people write (notes, reasons, messages), shared by all
// those fields: one row per text and language. German is always created, so
// Supervision can read every exchange. `text` is null when the text already is
// in that language.
model TextTranslation {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceHash String
  sourceLanguage String
  targetLanguage String
  text String?
  model String
  createdAt DateTime @default(now())
  @@unique([organizationId, sourceHash, targetLanguage])
}
