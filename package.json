{
  "name": "nuclear_waste_tracking_system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-demo.mjs",
    "dev:local": "node scripts/dev-demo.mjs",
    "dev:database": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app/api lib scripts tests",
    "seed": "node prisma/seed.js",
    "dev:doppler": "doppler run -p nuclear-waste-tracking-system -c dev -- next dev",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate && node scripts/generate-schema-field-meta.cjs",
    "db:migrate": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/validation.test.cjs",
    "test:integration": "node scripts/test-database.mjs",
    "organization:provision": "node --env-file-if-exists=.env scripts/provision-organization.cjs",
    "dev:demo": "node scripts/dev-demo.mjs",
    "check": "npm run db:validate && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-query": "5.102.3",
    "axios": "1.19.0",
    "bcryptjs": "3.0.3",
    "dayjs": "1.11.23",
    "next": "16.3.4",
    "next-auth": "4.24.15",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "react-icons": "5.7.0",
    "react-toastify": "11.1.0",
    "react-tooltip": "5.30.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.4",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "24.13.3",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "daisyui": "5.7.22",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "postcss": "^8.4.38",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.7.4",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "@embedded-postgres/linux-x64": true
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
